{
  "expo": {
    "name": "DRIVVE",
    "slug": "drivve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main.png",
    "userInterfaceStyle": "light",  
    "resizeMode": "contain",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#184080"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drivve.app",
      "buildNumber": "2",
      "requireFullScreen": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false,
        "googleMapsApiKey": "AIzaSyDUmZXstmZbpfNFfN-J08fc5Qac5AOfQMw"
      },
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },

    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#184080"
      },
      "package": "in.drivve.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDUmZXstmZbpfNFfN-J08fc5Qac5AOfQMw"
        }
      },
      "includeGoogleMaps": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",

      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],

      "@react-native-community/datetimepicker",

      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DRIVVE to use your location even when the app is closed.",
          "locationWhenInUsePermission": "Allow DRIVVE to use your location."
        }
      ],

      [
        "expo-camera",
        {
          "cameraPermission": "Allow DRIVVE to access your camera to scan boarding QR codes."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": false
    },

    "extra": {
      "apiUrl": "https://drivve-0-1.onrender.com",
      "eas": {
        "projectId": "65cf8431-128a-4317-9c88-aa9c1791a36f"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/65cf8431-128a-4317-9c88-aa9c1791a36f",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}